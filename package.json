{
  "name": "staffsync-hrms",
  "version": "1.0.0",
  "description": "StaffSync - Modern Human Resource Management System (MERN)",
  "scripts": {
    "server": "node server/src/index.js",
    "client": "npm run dev --prefix client",
    "seed": "node server/src/seeder.js",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "build": "npm run build --prefix client"
  },
  "keywords": ["hrms", "mern", "staffsync", "react", "express", "mongodb"],
  "author": "StaffSync Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
